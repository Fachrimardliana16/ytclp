# YT Clipper Configuration
# Copy to .env and modify for production

# Server
PORT=3000
NODE_ENV=development

# Database (Supabase/Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host:5432/ytclipper

# Auth
JWT_SECRET=your-secret-key-here

# Python path for transcript fetching
PYTHON_PATH=venv/bin/python3

# Transcript API package
# Install: pip install youtube-transcript-api
